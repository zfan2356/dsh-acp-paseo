{
  "name": "dsh-acp-paseo",
  "version": "0.1.0",
  "description": "dsh ⇄ Paseo integration bundle: an enhanced ACP bridge exposing DeepSeek Harness (dsh) agents to Paseo with auto-discovered model catalog, plan/execute modes, thinking levels, and native dsh slash commands.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-acp-paseo-launch": "bin/dsh-acp-paseo-launch.mjs",
    "dsh-acp-paseo-install-provider": "scripts/install-paseo-provider.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./codec": {
      "types": "./lib/types/codec.d.ts",
      "default": "./lib/codec.js"
    },
    "./catalog": {
      "types": "./lib/types/catalog.d.ts",
      "default": "./lib/catalog.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "scripts",
    "paseo",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "test": "node ../../scripts/test.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.17.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-plan-mode": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "0.17.1",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-plan-mode": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^22.20.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "paseo",
    "acp",
    "agent-client-protocol",
    "cordis-plugin",
    "dsh-bundle"
  ],
  "license": "MIT"
}
